# App
NEXTJS_ENV=development

# Admin auth (used to seed the admins table)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=change-me-strong-password
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Nodemailer / SMTP (Gmail app password, Resend SMTP, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@email.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Raza Ali <your-smtp-user@email.com>"

# Where new-inquiry alerts are sent (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=your-admin@email.com

# Used in email templates + SEO metadataBase / sitemap / canonical URLs
NEXT_PUBLIC_SITE_URL=https://razaali.dev

# Force search indexing on/off (optional). Default: only index when
# NODE_ENV=production and NEXT_PUBLIC_SITE_URL host is razaali.dev
# ALLOW_SEARCH_INDEXING=true
# ALLOW_SEARCH_INDEXING=false
